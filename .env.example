# --- Google Analytics 4 & Search Console (share the same service account) ---
GOOGLE_APPLICATION_CREDENTIALS=./credentials/ga4-service-account.json
GA4_PROPERTY_ID=your_property_id_here
# Full property URL as it appears in Search Console, e.g. https://www.rideauresidence.ca/
# Leave blank to skip Search Console entirely.
GSC_SITE_URL=

# --- Meta Marketing API ---
META_ACCESS_TOKEN=your_long_lived_token_here
META_AD_ACCOUNT_ID=act_your_ad_account_id_here
META_API_VERSION=v21.0

# --- AI Summary (optional — leave blank to skip) ---
# Get a key at console.anthropic.com (separate from a Claude.ai login, pay-as-you-go)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Email digest (used by `npm run digest`) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# For Gmail, use an App Password, not your normal password:
# https://myaccount.google.com/apppasswords
SMTP_PASS=your_app_password_here
DIGEST_TO_EMAIL=where_to_send_the_digest@example.com

# --- Server ---
PORT=3000
CACHE_MINUTES=15
